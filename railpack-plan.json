{
  "php": "8.3.*",
  "build": [
    "composer install --no-dev --optimize-autoloader --no-scripts --no-interaction",
    "npm ci",
    "npm run build",
    "php artisan config:cache",
    "php artisan route:cache",
    "php artisan view:cache"
  ],
  "start": "php artisan serve --host=0.0.0.0 --port=$PORT"
}
